APP_NAME="Müller Holding AG Intranet"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://intranet.mueller-holding.ag
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Produktion: MariaDB 10.11 / 11 (InnoDB, utf8mb4)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mhag_intranet
DB_USERNAME=mhag_intranet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=intranet.mueller-holding.ag
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Hinweis Reverse Proxy: Weiterleitungs-Kopfzeilen von Proxys auf localhost
# oder im privaten Netz werden automatisch anerkannt (bootstrap/app.php),
# damit Protokoll und echte Client-IP korrekt erkannt werden.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="kontakt@mueller-holding.ag"
MAIL_FROM_NAME="${APP_NAME}"

# Dokumentenablage: local oder sftp (bevorzugt sftp, Abschnitt 59 Masterprompt)
DOCUMENT_DISK=local

SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
# Bevorzugt: SSH-Key-Authentifizierung (Pfad zum Private Key)
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
# Alternativ Passwort (nur wenn kein Key möglich)
SFTP_PASSWORD=
SFTP_ROOT_PATH=/mueller-holding
SFTP_TIMEOUT=15
# Host-Key-Fingerprint zur Prüfung (ssh-keyscan), leer = keine Prüfung (nicht empfohlen)
SFTP_HOST_FINGERPRINT=

# ---------------------------------------------------------------------------
# Digitale Signatur (Abschnitte 99 bis 102)
# ---------------------------------------------------------------------------
# Aktiver Signaturweg: manual (Standard) oder docusign.
# Erst umstellen, wenn der Verbindungstest unter Administration, DocuSign
# erfolgreich war.
SIGNATURE_PROVIDER=manual

# Basis-URL der eSignature-API, mit oder ohne /restapi
# Test:  https://demo.docusign.net/restapi
# Live:  die im Konto genannte Adresse, z. B. https://eu.docusign.net/restapi
DOCUSIGN_BASE_URL=

# API-Konto (Account-ID, GUID) aus Einstellungen, Apps und Schluessel
DOCUSIGN_ACCOUNT_ID=

# API-Benutzer (User-ID, GUID), in dessen Namen gehandelt wird
DOCUSIGN_USER_ID=

# Integrationsschluessel der App (Client-ID, GUID)
DOCUSIGN_INTEGRATION_KEY=

# Privater RSA-Schluessel: Pfad zur Datei (empfohlen, ausserhalb von public/)
# oder der Schluessel selbst im PEM-Format. Ist der Wert leer, wird er nicht
# uebergeben; die Anmeldung ist dann nicht moeglich.
DOCUSIGN_PRIVATE_KEY=

# Anmeldeserver: Test account-d.docusign.com, Live account.docusign.com
DOCUSIGN_OAUTH_HOST=account-d.docusign.com

# Geheimnis der Connect-Benachrichtigung (HMAC). Ohne Geheimnis wird keine
# Benachrichtigung angenommen.
DOCUSIGN_WEBHOOK_SECRET=

# Betreff der Signatur-E-Mail an die Unterzeichner
DOCUSIGN_EMAIL_SUBJECT="Dokument zur Unterschrift, Mueller Holding AG"

DOCUSIGN_TIMEOUT=20
# Ankertext im PDF, an dem das Signaturfeld platziert wird
DOCUSIGN_ANCHOR_STRING=Unterschrift

# Backup
BACKUP_PATH=storage/backups

VITE_APP_NAME="${APP_NAME}"
