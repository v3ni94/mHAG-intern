# Vorlage fuer .env.prod auf dem Server.
#
#   cp infra/env.prod.example .env.prod && chmod 600 .env.prod
#
# Die Datei liegt ausschliesslich auf dem Server, niemals im Repository.
# Jeder Wert "aendern" ist zu ersetzen. Diese Datei dient docker compose
# zugleich als Quelle der Platzhalter und als Umgebung der Container
# (infra/compose.yaml fuehrt die uebernommenen Werte einzeln auf).
#
# ZEICHENREGEL FUER KENNWOERTER
# docker compose ersetzt in dieser Datei ${NAME}- und $NAME-Ausdruecke. Ein
# Kennwort mit einem Dollarzeichen wird dadurch stillschweigend veraendert:
# aus "ab$cd" wird "ab", weil $cd als leere Variable gelesen wird. Die
# Anmeldung schlaegt dann mit einer irrefuehrenden Meldung fehl.
# Deshalb:
#   - Kennwoerter ohne $ verwenden (empfohlen), oder
#   - jedes Dollarzeichen als $$ schreiben.
# Ebenfalls meiden: das Zeichen # innerhalb eines Wertes ohne
# Anfuehrungszeichen, es beginnt sonst einen Kommentar.

# ---------------------------------------------------------------------------
# Abbild und Traefik
# ---------------------------------------------------------------------------
# Ohne Registry werden die Abbilder auf dem Server gebaut.
INTRANET_IMAGE_REGISTRY=local

# Kennzeichnung der Abbilder. scripts/server-deploy.sh setzt hier bei jedem
# Lauf den kurzen Commit ein und legt ihn zusaetzlich in .deployed-tag ab;
# scripts/mhag.sh liest ihn von dort. Der Eintrag hier wird nur gebraucht,
# wenn docker compose einmal von Hand ohne diese Skripte aufgerufen wird.
INTRANET_IMAGE_TAG=latest

# Vorhandenes Traefik-Netz des Servers. Muss mit dem CRM uebereinstimmen.
TRAEFIK_NETWORK=traefik-proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
INTRANET_TRAEFIK_PREFIX=mhag-intranet

INTRANET_HOST=intern.mueller-holding.ag

# ---------------------------------------------------------------------------
# Anwendung
# ---------------------------------------------------------------------------
APP_NAME="Müller Holding AG Intranet"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://intern.mueller-holding.ag
APP_TIMEZONE=Europe/Berlin

# Einmalig erzeugen:
#   docker run --rm local/mhag-intranet-app:<tag> php artisan key:generate --show
APP_KEY=aendern

# Nur belegen, wenn APP_KEY gewechselt wurde. Mit dem alten Schluessel
# verschluesselte Felder (Geheimnisse der Zwei-Faktor-Anmeldung) bleiben
# dadurch lesbar. Mehrere Schluessel mit Komma trennen, ohne Leerzeichen.
APP_PREVIOUS_KEYS=

# Zeitzone der Anzeige und des Zeitplans. Gespeichert wird in UTC.
APP_DISPLAY_TIMEZONE=Europe/Berlin

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Datenbank (Dienst db im selben Stapel, kein Port nach aussen)
# ---------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mhag_intranet
DB_USERNAME=mhag_intranet
DB_PASSWORD=aendern
DB_ROOT_PASSWORD=aendern

# Groesse des InnoDB-Puffers. Der Server teilt sich den Arbeitsspeicher mit
# dem CRM; bei Engpaessen senken statt erhoehen.
DB_INNODB_BUFFER_POOL_SIZE=1G
DB_MAX_CONNECTIONS=200

# ---------------------------------------------------------------------------
# Sitzung
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_DOMAIN=intern.mueller-holding.ag
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------------
# E-Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=aendern
MAIL_PORT=587
MAIL_USERNAME=aendern
MAIL_PASSWORD=aendern
MAIL_FROM_ADDRESS="kontakt@mueller-holding.ag"
MAIL_FROM_NAME="Müller Holding AG Intranet"

# ---------------------------------------------------------------------------
# Dokumentenablage: local (Volume storage) oder sftp
# ---------------------------------------------------------------------------
DOCUMENT_DISK=local
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
SFTP_PASSWORD=
SFTP_ROOT_PATH=/mueller-holding
SFTP_HOST_FINGERPRINT=

# ---------------------------------------------------------------------------
# Digitale Signatur: manual oder docusign
# ---------------------------------------------------------------------------
SIGNATURE_PROVIDER=manual
DOCUSIGN_BASE_URL=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Sicherung
# ---------------------------------------------------------------------------
# Liegt im Volume "sicherungen" des Stapels. Die Kopie ausserhalb des Servers
# richtet der Serverbetrieb ein (siehe docs/DEPLOYMENT-SERVER.md, Abschnitt 7).
BACKUP_PATH=storage/backups

# Aufbewahrungsdauer der taeglichen Sicherungen in Tagen. 0 schaltet das
# Aufraeumen ab; dann waechst das Volume unbegrenzt.
BACKUP_RETENTION_DAYS=30

# Sicherungen komprimieren.
BACKUP_COMPRESS=true
