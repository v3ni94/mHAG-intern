APP_NAME="Müller Holding AG Intranet"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://intranet.mueller-holding.ag
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Produktion: MariaDB 10.11 / 11 (InnoDB, utf8mb4)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mhag_intranet
DB_USERNAME=mhag_intranet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=intranet.mueller-holding.ag
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="kontakt@mueller-holding.ag"
MAIL_FROM_NAME="${APP_NAME}"

# Dokumentenablage: local oder sftp (bevorzugt sftp, Abschnitt 59 Masterprompt)
DOCUMENT_DISK=local

SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
# Bevorzugt: SSH-Key-Authentifizierung (Pfad zum Private Key)
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
# Alternativ Passwort (nur wenn kein Key möglich)
SFTP_PASSWORD=
SFTP_ROOT_PATH=/mueller-holding
SFTP_TIMEOUT=15
# Host-Key-Fingerprint zur Prüfung (ssh-keyscan), leer = keine Prüfung (nicht empfohlen)
SFTP_HOST_FINGERPRINT=

# Backup
BACKUP_PATH=storage/backups

VITE_APP_NAME="${APP_NAME}"
